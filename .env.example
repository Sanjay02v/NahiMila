# Local typed demo works without keys. Secrets never belong in NEXT_PUBLIC variables.
# Gemini understands text; Sarvam transcribes real audio. Restart after changing keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
SARVAM_API_KEY=
# Hosted mode requires ALL THREE credentials and the merchant_product migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional custom password for newly created fictional Supabase demo accounts.
NML_DEMO_PASSWORD=
