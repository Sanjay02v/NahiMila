# Local typed demo works without keys. Secrets never belong in NEXT_PUBLIC variables.
# Gemini understands text; Sarvam transcribes real audio. Restart after changing keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SARVAM_API_KEY=
# Hosted mode requires ALL THREE credentials and the merchant_product migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional custom password for newly created fictional Supabase demo accounts.
NML_DEMO_PASSWORD=
# Shared project/model budget; keep this scope unchanged when rotating API keys.
# Safe headroom for the pictured 15 RPM / 500 RPD / 250K input TPM plan.
# Limits count provider attempts; daily reset is midnight Pacific.
GEMINI_MAX_RPM=12
GEMINI_MAX_RPD=450
GEMINI_MAX_INPUT_TPM=200000
GEMINI_429_COOLDOWN_SECONDS=60
GEMINI_QUOTA_SCOPE=nahimila-google-project
